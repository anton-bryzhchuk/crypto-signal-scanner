# === Telegram user account (for reading monitored channels) ===
# Get API ID / hash at https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=+100000000

# === Telegram bot (for sending alerts) ===
# Create a bot via @BotFather
BOT_TOKEN=
# Your own Telegram user id (ask @userinfobot)
OWNER_CHAT_ID=

# === Anthropic Claude API (used to score / filter signals) ===
ANTHROPIC_API_KEY=

# === Exchange market-data APIs (optional, read-only) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# === On-chain data providers (optional) ===
# Free Etherscan V2 key (works across EVM chains) at https://etherscan.io
ETHERSCAN_API_KEY=
# Solscan Pro key at https://pro.solscan.io
SOLSCAN_API_KEY=

# === Tuning ===
MIN_SCORE=7              # minimum Claude score (1-10) required to send an alert
FUNDING_THRESHOLD=0.05   # funding-rate % that triggers a funding alert
ARB_THRESHOLD=0.3        # cross-exchange spread % that triggers an arbitrage alert
DUMP_DROP_PCT=35         # price drop % that triggers a dump alert
DUMP_WINDOW_MIN=30       # lookback window (minutes) for the dump detector
